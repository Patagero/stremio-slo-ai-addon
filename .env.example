PORT=7002
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Google Gemini 3.1 Pro (prevajanje + analiza likov in spolov)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
ANALYSIS_MODEL=gemini-3.1-pro-preview

# TMDB (podatki o igralcih in spolih) - brezplačni ključ na themoviedb.org
TMDB_API_KEY=

# OpenSubtitles (izvorni podnapisi po prioriteti: HR -> IT -> EN)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=SloAIAddon v0.7.0
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Nadzor hitrosti branja (CPS - characters per second) in dolžine
TARGET_CPS=17
MAX_LINE_CHARS=42

GITHUB_REPOSITORY=Patagero/stremio-slo-ai-addon
GITHUB_BRANCH=main
RENDER_AUTO_DEPLOY=true
