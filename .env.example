PORT=7002
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Google Gemini (translation + character/gender analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optionally use a different (e.g. cheaper) model for pass 1 (character/gender ledger
# analysis) while GEMINI_MODEL handles the main translation. Defaults to GEMINI_MODEL.
ANALYSIS_MODEL=

# TMDB (cast gender metadata for method #5) - free API key from themoviedb.org
TMDB_API_KEY=

# OpenSubtitles (source subtitles: EN, HR, IT)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=SloAIAddon v0.5.0
# Optional but recommended: real account login (not just the API key) unlocks a much higher
# daily quota on OpenSubtitles than anonymous API-key-only access.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Reading-speed control (method for "not too fast" subtitles)
TARGET_CPS=17
MAX_LINE_CHARS=42

GITHUB_REPOSITORY=YOUR_USER/stremio-slo-ai-addon
GITHUB_BRANCH=main
RENDER_AUTO_DEPLOY=true
WORKER_CACHE_TTL_SECONDS=2592000

# The addon never exposes these secrets in the manifest or subtitle response.