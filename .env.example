PORT=7002
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Anthropic Sonnet 5.5 (prevajanje + analiza likov in spolov)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANALYSIS_MODEL=claude-sonnet-5-5

# TMDB (podatki o igralcih in spolih) - brezplačni ključ na themoviedb.org
TMDB_API_KEY=

# OpenSubtitles (izvorni podnapisi: EN, HR, ITA)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=SloAIAddon v0.6.0
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Nadzor hitrosti branja (CPS - characters per second)
TARGET_CPS=17
MAX_LINE_CHARS=42

GITHUB_REPOSITORY=Patagero/stremio-slo-ai-addon
GITHUB_BRANCH=main
RENDER_AUTO_DEPLOY=true
